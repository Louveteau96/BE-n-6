    infos = "lrec 1 1 09:53 03-02-26 0C105004 0.000 0.000 0 7 20.2 46.5 63.6 0.754 0.721 747.0"
    df = ajouter_infos(df,infos)
    print(df)
    df.to_csv("resultats.csv",index=False)

main()

